# --------------------------------------------------
# Build
# --------------------------------------------------

build/

# --------------------------------------------------
# Python environments and cache
# --------------------------------------------------

analysis/.venv/
.venv/

__pycache__/
*.pyc

# --------------------------------------------------
# Generated simulation data
# --------------------------------------------------

*.csv
*.root

# Ignore generated Geant4 results by default
results/*

# Keep the runs directory accessible for exceptions
!results/runs/

# Ignore individual runs by default
results/runs/*

# Keep the validated Geant4 reference run
!results/runs/run_1000_tracks_v1/
!results/runs/run_1000_tracks_v1/**

# --------------------------------------------------
# DAQ generated working data
# --------------------------------------------------

daq/data/*

# Keep the DAQ Bench v0.1 reference files already used
!daq/data/simulated_adc.csv
!daq/data/minineutron_daq.root
!daq/data/adc_histogram.png
!daq/data/root_adc_histogram.png
!daq/data/root_voltage_vs_time.png
!daq/data/voltage_vs_time.png

# Keep validated DAQ reference runs
!daq/reference/
!daq/reference/v0.2/
!daq/reference/v0.2/**

# --------------------------------------------------
# LaTeX temporary files
# --------------------------------------------------

*.aux
*.log
*.out
*.toc
*.synctex.gz
*.fls
*.fdb_latexmk

# --------------------------------------------------
# Editor / system files
# --------------------------------------------------

.vscode/
.DS_Store